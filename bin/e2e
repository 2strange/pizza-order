#!/usr/bin/env bash
# Runs the Cypress end-to-end suite against a test-mode Rails server.
set -euo pipefail
cd "$(dirname "$0")/.."

export RAILS_ENV=test
bin/rails db:prepare
bin/vite build --mode test

bin/rails server -p 3000 -d --pid tmp/pids/e2e.pid
trap 'kill "$(cat tmp/pids/e2e.pid)" 2>/dev/null || true' EXIT

for _ in $(seq 1 30); do
  curl -fs http://localhost:3000 >/dev/null && break
  sleep 1
done

npx cypress run "$@"
