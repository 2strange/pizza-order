<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Pizza Order" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Pizza Order">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= vite_client_tag %>
    <%= vite_javascript_tag "application" %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
